                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Auto (2)" Click="BtnSetServiceAuto_Click" Tag="{Binding ServiceName}" Background="#10B981" Foreground="White" BorderThickness="0" Padding="6,3" Margin="0,0,4,0" Cursor="Hand"/>
                                                    <Button Content="Manual (3)" Click="BtnSetServiceManual_Click" Tag="{Binding ServiceName}" Background="#0EA5E9" Foreground="White" BorderThickness="0" Padding="6,3" Margin="0,0,4,0" Cursor="Hand"/>
                                                    <Button Content="Disabled (4)" Click="BtnSetServiceDisabled_Click" Tag="{Binding ServiceName}" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="6,3" Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 9. Overlay Modal: Windows Debloater & Tweak Engine -->
        <Grid x:Name="ModalDebloatOverlay" Background="#CC090D16" Visibility="Collapsed">
            <Border Style="{StaticResource GlassCard}" Width="920" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#38BDF8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🛡️ WINDOWS 10/11 DEBLOATER &amp; OPTIMIZATION SUITE" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 Load Debloat List" Style="{StaticResource BtnOutline}" Click="BtnRefreshDebloat_Click" Margin="0,0,12,0"/>
                            <Button Content="✕ Đóng" Style="{StaticResource BtnOutline}" Click="BtnCloseDebloatModal_Click" Padding="12,6"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="DgDebloat" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Phân Loại" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Tên Mục Tinh Chỉnh" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Mô Tả Chi Tiết" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnApplyDebloat" Content="🚀 ÁP DỤNG DEBLOAT VÀ TINH CHỈNH ĐÃ CHỌN" Style="{StaticResource BtnExecute}" Click="BtnApplyDebloat_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 10. Overlay Modal: Secure File Shredder Tool -->
        <Grid x:Name="ModalShredOverlay" Background="#CC090D16" Visibility="Collapsed">
            <Border Style="{StaticResource GlassCard}" Width="750" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#EF4444">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="🔒 SECURE FILE SHREDDER (XÓA ĐÈ CHỐNG KHÔI PHỤC)" FontSize="16" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                        <Button Content="✕ Đóng" Style="{StaticResource BtnOutline}" Click="BtnCloseShredModal_Click" HorizontalAlignment="Right" Padding="12,6"/>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Đường Dẫn Tệp Hoặc Thư Mục Cần Tiêu Hủy:" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E293B" CornerRadius="8" Padding="10,6" BorderBrush="#334155" BorderThickness="1">
                                <TextBox x:Name="TxtShredTargetPath" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" Text="C:\Path\To\File_Or_Folder..."/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Chọn Thuật Toán Xóa Đè Dữ Liệu An Toàn:" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,16">
                            <RadioButton x:Name="rb_ShredDoD" GroupName="shred_algo" Content="DoD 5220.22-M (3-Passes: Zeros -> Ones -> Pseudo-Random)" IsChecked="True" Margin="0,0,0,8"/>
                            <RadioButton x:Name="rb_ShredRandom" GroupName="shred_algo" Content="Random Fill (1-Pass: Ghi đè chuỗi ngẫu nhiên)" Margin="0,0,0,8"/>
                            <RadioButton x:Name="rb_ShredZero" GroupName="shred_algo" Content="Zero Fill (1-Pass: Ghi đè 0x00 siêu tốc)"/>
                        </StackPanel>

                        <TextBlock Text="⚠️ CẢNH BÁO: Dữ liệu sau khi bị Shred sẽ bị xóa đè trực tiếp trên các sector ổ đĩa và KHÔNG THỂ KHÔI PHỤC bằng bất kỳ phần mềm cứu dữ liệu nào!" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="BtnExecuteShred" Content="🔥 BẮT ĐẦU TIÊU HỦY DỮ LIỆU AN TOÀN" Style="{StaticResource BtnExecute}" Background="#EF4444" Click="BtnExecuteShred_Click" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
