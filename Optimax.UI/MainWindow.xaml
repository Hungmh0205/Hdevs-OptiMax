<Window x:Class="Optimax.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Optimax.UI"
        Title="OPTIMAX - BỘ TỐI ƯU HÓA WINDOWS TOÀN DIỆN (WPF NATIVE)" Height="740" Width="1140" MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">

    <Window.Resources>
        <local:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <local:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <!-- Modern Dark Glass Card Style -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Preset Card Style -->
        <Style x:Key="PresetCard" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Custom CheckBox Card Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CardBorder" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBorder" Width="20" Height="20" CornerRadius="5" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="CheckMark" Text="✓" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#0F172A"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RadioBorder" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#0EA5E9" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="BtnExecute" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="#0EA5E9" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnOutline" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#111827"/>
            <Setter Property="AlternatingRowBackground" Value="#1E293B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Metrics Grid (3 Cards) -->
                    <RowDefinition Height="Auto"/> <!-- Mode Presets -->
                    <RowDefinition Height="Auto"/> <!-- Smart Autopilot -->
                    <RowDefinition Height="Auto"/> <!-- 2-Column Options -->
                    <RowDefinition Height="Auto"/> <!-- Quick Native Engines Bar -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Action Panel -->
                    <RowDefinition Height="Auto"/> <!-- Log Console -->
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OPTIMAX" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,12,0"/>
                            <Border Background="#0EA5E9" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="WPF NATIVE V2.0" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Bộ Công Cụ Tinh Chỉnh Hiệu Năng Máy Trạm &amp; Gaming PC • Kernel, RAM, Ổ Đĩa &amp; Mạng" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AdminBadge" Background="#1E293B" CornerRadius="20" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtAdminStatus" Text="QUYỀN HỆ THỐNG: QUYỀN ADMIN" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnAutostartBadge" Click="BtnAutostartBadge_Click" Style="{StaticResource BtnOutline}" Padding="14,6">
                            <TextBlock x:Name="TxtAutostartBadge" Text="TỰ ĐỘNG KHỞI ĐỘNG: ĐANG KIỂM TRA..." FontSize="12" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="BtnImportWinapp2" Click="BtnImportWinapp2_Click" Style="{StaticResource BtnOutline}" Padding="14,6" Margin="10,0,0,0">
                            <TextBlock Text="📂 NẠP RULE WINAPP2.INI" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Metrics Grid (3 Cards) -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: RAM -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="🧠 BỘ NHỚ RAM" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="THỜI GIAN THỰC" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="TxtRamUsedVal" Grid.Row="1" Text="-- GB (--%)" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,8,0,4"/>
                            <TextBlock x:Name="TxtRamFreeSub" Grid.Row="2" Text="CÒN TRỐNG: -- GB / -- GB" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="PbRam" Grid.Row="3" Height="6" Value="0" Maximum="100" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: CPU -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="⚡ MỨC TẢI CPU &amp; NĂNG LƯỢNG" FontSize="12" FontWeight="Bold" Foreground="#A855F7"/>
                                <TextBlock x:Name="TxtPowerPlanBadge" Text="ULTIMATE PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="TxtCpuLoadVal" Grid.Row="1" Text="0% MỨC TẢI" FontSize="22" FontWeight="Bold" Foreground="#A855F7" Margin="0,8,0,4"/>
                            <TextBlock x:Name="TxtCpuInfoSub" Grid.Row="2" Text="Intel Processor | Active Workstation" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="PbCpu" Grid.Row="3" Height="6" Value="0" Maximum="100" Background="#1E293B" Foreground="#A855F7" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Card 3: NETWORK & DISK -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="🌐 TỐC ĐỘ MẠNG &amp; Ổ ĐĨA C:" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="TxtNetTypeBadge" Text="CARD MẠNG" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="TxtNetSpeedVal" Grid.Row="1" Text="TẢI VỀ: 0.0 KB/s | TẢI LÊN: 0.0 KB/s" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,12,0,6"/>
                            <TextBlock x:Name="TxtDiskFreeSub" Grid.Row="2" Text="Ổ C: -- GB TRỐNG" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="PbDisk" Grid.Row="3" Height="6" Value="0" Maximum="100" Background="#1E293B" Foreground="#10B981" BorderThickness="0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Mode Presets Selector -->
                <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="⭐ CHỌN CHẾ ĐỘ TỐI ƯU CẤU HÌNH SẴN (MODE PRESETS)" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CardPresetPc" Grid.Column="0" Style="{StaticResource PresetCard}" BorderBrush="#0EA5E9" Margin="0,0,12,0" MouseDown="PresetPc_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🖥️" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="PC MODE (MÁY TÍNH ĐỂ BÀN)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Tối ưu tối đa hiệu năng Gaming &amp; Workstation. Tắt VBS, tắt Hibernation, chọn Ultimate Power Plan." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#0EA5E9" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                        <TextBlock Text="EXTREME PERFORMANCE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="CardPresetLaptop" Grid.Column="1" Style="{StaticResource PresetCard}" MouseDown="PresetLaptop_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="💻" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="LAPTOP MODE (MÁY TÍNH XÁCH TAY)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Tối ưu an toàn. Giữ Hibernation/Sleep, giữ Windows Search &amp; Spooler, bật VBS, chọn Balanced Power Plan." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#10B981" CornerRadius="6" Padding="8,4" VerticalAlignment="Top">
                                        <TextBlock Text="BATTERY &amp; SAFE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Smart Auto-Pilot Daemon Section -->
                <Border Grid.Row="3" Style="{StaticResource GlassCard}" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️ CHẾ ĐỘ AUTO-PILOT ĐẠI LÝ CHỦ ĐỘNG (REALTIME MONITOR)" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,0,10,0"/>
                                <Border Background="#064E3B" CornerRadius="6" Padding="8,2">
                                    <TextBlock Text="ZERO-USER INTERVENTION" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Tự động theo dõi rác đĩa C: (>10GB) &amp; mức chiếm RAM (>85%) để xả RAM/dọn rác ngầm không gây làm phiền." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleAutopilot" Grid.Column="1" Content="TRẠNG THÁI: DỪNG (OFF)" Style="{StaticResource BtnOutline}" Click="BtnToggleAutopilot_Click" Padding="16,8"/>
                    </Grid>
                </Border>

                <!-- 5. 2-Column Core Options Grid -->
                <Grid Grid.Row="4" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUMN 1: Essential Cleaners & Tweaks -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="🚀 CỘT 1: CÁC HẠNG MỤC DỌN RÁC &amp; TINH CHỈNH CORE" FontSize="13" FontWeight="Bold" Foreground="#0EA5E9"/>
                                <Border Background="#0369A1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                    <TextBlock Text="AUTOMATIC SCAN" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>

                            <StackPanel x:Name="Col1Checkboxes">
                                <CheckBox x:Name="chk_SysTempClean" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="1. Dọn Dẹp Tệp Tạm Hệ Thống (%TEMP%, WinTemp, Prefetch)" FontWeight="Bold"/><TextBlock Text="Giải phóng hàng chục GB rác sinh ra bởi ứng dụng và Windows Update." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"><TextBlock Text="-SysTemp" FontSize="10" Foreground="#38BDF8"/></Border>
                                    </Grid>
                                </CheckBox>

                                <CheckBox x:Name="chk_DisableVBS" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="2. Tắt VBS / Memory Integrity (Tăng FPS Game)" FontWeight="Bold"/><TextBlock Text="Vô hiệu hóa Virtualization-based Security giúp tăng 5-15% FPS trong Game." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"><TextBlock Text="-DisableVBS" FontSize="10" Foreground="#38BDF8"/></Border>
                                    </Grid>
                                </CheckBox>

                                <CheckBox x:Name="chk_DeepJunk" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="3. Dọn Shader Cache GPU &amp; Cache Trình Duyệt" FontWeight="Bold"/><TextBlock Text="Xóa DirectX/NVIDIA/AMD Shader cache, Browser Cache (Chrome, Edge, Firefox)." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"><TextBlock Text="-DeepJunk" FontSize="10" Foreground="#38BDF8"/></Border>
                                    </Grid>
                                </CheckBox>

                                <CheckBox x:Name="chk_MSIMode" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="4. Bật PCIe MSI Mode (GPU &amp; Network)" FontWeight="Bold"/><TextBlock Text="Chuyển ngắt IRQ sang Message Signaled Interrupts, giảm DPC Latency Spikes." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"><TextBlock Text="-MSIMode" FontSize="10" Foreground="#38BDF8"/></Border>
                                    </Grid>
                                </CheckBox>

                                <CheckBox x:Name="chk_DisableMPO" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="5. Tắt Multi-Plane Overlay (MPO)" FontWeight="Bold"/><TextBlock Text="Sửa triệt để lỗi chớp màn hình, nhấp nháy đen DWM khi vừa xem video vừa chơi game." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"><TextBlock Text="-DisableMPO" FontSize="10" Foreground="#38BDF8"/></Border>
                                    </Grid>
                                </CheckBox>

                                <CheckBox x:Name="chk_QoSNet" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="6. Mở khóa 100% QoS &amp; Fast Cloudflare DNS" FontWeight="Bold"/><TextBlock Text="Loại bỏ 20% giới hạn băng thông ngầm và tự động cấu hình DNS 1.1.1.1 siêu tốc." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/></StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top"><TextBlock Text="-QoSNet" FontSize="10" Foreground="#38BDF8"/></Border>
                                    </Grid>
                                </CheckBox>

                                <CheckBox x:Name="chk_MultiDriveTrim" IsChecked="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
